# ClinicaFlow - Environment Variables
# Copy to .env.local and fill in your values

# ──────────────────────────────────────
# Frontend
# ──────────────────────────────────────
VITE_API_URL=/api
VITE_NODE_ENV=development

# ──────────────────────────────────────
# Supabase
# ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ──────────────────────────────────────
# OpenAI (required for AI personalization + agent)
# ──────────────────────────────────────
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────
# WhatsApp – Evolution API
# Configure in: Settings → Integrações
# These are stored per-user in user_settings table.
# Server-side defaults (optional):
# ──────────────────────────────────────
# EVOLUTION_API_URL=https://evolution.yourdomain.com
# EVOLUTION_API_KEY=your_evolution_api_key
# EVOLUTION_INSTANCE_NAME=your_instance_name

# ──────────────────────────────────────
# WhatsApp – Meta Business Cloud API (optional)
# Configure in: Settings → Integrações
# These are stored per-user in user_settings table.
# ──────────────────────────────────────
# META_PHONE_NUMBER_ID=your_phone_number_id
# META_ACCESS_TOKEN=your_meta_access_token

# ──────────────────────────────────────
# Webhook (Meta verification challenge)
# ──────────────────────────────────────
META_WEBHOOK_VERIFY_TOKEN=change_me_to_a_random_secret
